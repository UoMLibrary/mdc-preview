		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^2.30.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"svelte": "^5.55.9",
		"svelte-check": "^3.4.3",
		"typescript": "^5.0.0",
		"vite": "^8.0.14"
	},
	"dependencies": {
		"@zerodevx/svelte-json-view": "^1.0.7",
		"idb-keyval": "^6.2.1",
